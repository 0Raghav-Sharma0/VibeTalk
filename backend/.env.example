# Server
NODE_ENV=development
PORT=5001

# Database (required)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/vibetalk

# Auth (required) — Clerk JWT issuer, no trailing slash
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev

# Redis (required for WhatsApp-style queues)
REDIS_URL=redis://localhost:6379

# Workers — production: API enqueues only, separate worker process delivers
RUN_WORKERS_IN_API=true
WORKER_ONLY=false
MESSAGE_WORKER_CONCURRENCY=100
GROUP_WORKER_CONCURRENCY=40
RECEIPT_WORKER_CONCURRENCY=50
MESSAGE_DELIVERY_ATTEMPTS=8

# --- 10k concurrent scale (see deploy/nginx + docker-compose.scale.yml) ---
# RUN_WORKERS_IN_API=false  # required in production API pods
# SCALE_TARGET_CONCURRENT=10000
# SCALE_API_REPLICAS=4
# SCALE_WORKER_REPLICAS=6
# SOCKET_WEBSOCKET_ONLY=true
# SOCKET_PER_MESSAGE_DEFLATE=false
# MONGODB_MAX_POOL_SIZE=80
# MONGODB_MIN_POOL_SIZE=10
# SOCKET_METRICS_LOG=true

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Behind Nginx reverse proxy (production)
TRUST_PROXY=true

# Optional media
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
