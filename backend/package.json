{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "dev:api": "RUN_WORKERS_IN_API=false nodemon src/index.js",
    "dev:worker": "WORKER_ONLY=true nodemon src/workers/standalone.js",
    "start": "node src/index.js",
    "start:worker": "WORKER_ONLY=true node src/workers/standalone.js",
    "worker": "WORKER_ONLY=true node src/workers/standalone.js",
    "test": "node --test tests/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "load-test": "node scripts/load-test.mjs",
    "verify": "node scripts/verify-all.mjs",
    "verify:loop": "node scripts/verify-loop.mjs",
    "migrate:drop-legacy-friendrequest-index": "node scripts/drop-legacy-friendrequest-index.js",
    "db:clear": "node scripts/clear-database.js",
    "clerk:clear-users": "node scripts/clear-clerk-users.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.10",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "redis": "^5.9.0",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
