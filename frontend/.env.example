# Clerk (https://dashboard.clerk.com) — sign-in, sign-up, Google OAuth, email + password
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# In Clerk Dashboard → User & authentication, enable:
# - Google (Social connections)
# - Email address + Email verification code (OTP) and/or Password


# Backend API (production — no trailing slash)
VITE_BACKEND_URL=https://your-api.onrender.com

# Optional: explicit socket URL (defaults to VITE_BACKEND_URL)
# VITE_SOCKET_URL=https://your-api.onrender.com

# WebRTC TURN (optional)
# VITE_TURN_URL=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
